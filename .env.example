# Persistent application database. Do not use the disposable test database here.
DATABASE_URL=postgresql://signalroom:change-me@localhost:5432/signal_room

# Generate a unique value with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Public base URL of this SignalRoom instance.
AUTH_URL=http://localhost:3000

# Dedicated disposable database. Automated tests migrate and truncate/reset it.
TEST_DATABASE_URL=postgresql://signalroom:change-me@localhost:5432/signal_room_test
